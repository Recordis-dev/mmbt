# Solana
SOLANA_WALLET_PUBLIC_KEY=your_public_key
SOL_USD=150
JUPITER_SLIPPAGE_BPS=1500
JUPITER_EXIT_SLIPPAGE_BPS=2000
JUPITER_MAX_PRIORITY_LAMPORTS=10000000

# Secure signer service. Required for live trading.
# The workflow sends serialized Jupiter transactions here for signing/broadcasting.
SIGNER_URL=http://127.0.0.1:8787/sign-and-send
SIGNER_API_KEY=your_signer_api_key

# Security APIs
RUGCHECK_API_KEY=your_api_key
GOPLUS_API_KEY=your_api_key
SOLSNIFFER_API_KEY=your_api_key

# Database and Redis
DATABASE_URL=postgres://user:password@localhost:5432/trench
REDIS_URL=redis://localhost:6379
