# ─── Solana / Jupiter ────────────────────────────────────────────────────────
SOLANA_WALLET_PUBLIC_KEY=your_public_key
SOL_USD=150
JUPITER_SLIPPAGE_BPS=1500
JUPITER_EXIT_SLIPPAGE_BPS=2000
JUPITER_MAX_PRIORITY_LAMPORTS=10000000

# ─── Secure signer service ───────────────────────────────────────────────────
# Required for live trading. If unset, the workflow runs in PAPER MODE.
# Signer should return: { txHash, amount, solReceivedLamports?, feeLamports? }
SIGNER_URL=http://127.0.0.1:8787/sign-and-send
SIGNER_API_KEY=your_signer_api_key

# ─── Security providers ──────────────────────────────────────────────────────
RUGCHECK_API_KEY=your_api_key
GOPLUS_API_KEY=your_api_key
SOLSNIFFER_API_KEY=your_api_key

# Optional: Birdeye supplies real holder count + top10 % concentration that
# DexScreener does not return. Without it, the learning pattern_key for those
# dimensions collapses to "unknown".
BIRDEYE_API_KEY=

# ─── Budget & risk tunables (override DEFAULT_LIMITS) ────────────────────────
BASE_BET_USD=0.25
MIN_BET_USD=0.10
DAILY_LOSS_LIMIT_USD=-15
REDUCE_LOSS_THRESHOLD=-10
HARD_REDUCE_LOSS_THRESHOLD=-20
MAX_CONSECUTIVE_LOSSES=15
POSITION_TIMEOUT_MS=2700000
API_FAILURES_THRESHOLD=20

# ─── Security thresholds ─────────────────────────────────────────────────────
RUGCHECK_MAX_SCORE=500
SOLSNIFFER_MAX_TOP10_PCT=25

# ─── Monitor / exit tunables ─────────────────────────────────────────────────
HARD_STOP_FRACTION=0.34
PARTIAL_TP_MULTIPLIER=2
PARTIAL_TP_FRACTION=0.5
RISK_SIGNAL_THRESHOLD=3
VOLUME_DECLINE_RATIO=0.5
HOLDER_DROP_RATIO=0.9
SELL_PRESSURE_RATIO=3

# ─── Database & infra ────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/trench
